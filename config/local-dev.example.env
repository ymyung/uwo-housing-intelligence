# Local developer defaults only. Copy this file to config/local-dev.env.
# Existing process variables take precedence over values loaded from this file.
OTP_BASE_URL=http://127.0.0.1:8080
POSTGRES_USER=uwo
POSTGRES_DB=uwo_housing_dev
POSTGRES_PASSWORD=
JAVA_TOOL_OPTIONS=-Xmx8g

# ACCESSIBILITY_DATABASE_URL is normally reconstructed in memory from the
# Compose-managed uwo-postgres-dev container. Set it only when using the
# expected localhost uwo_housing_dev database.
# ACCESSIBILITY_DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:55600/uwo_housing_dev
